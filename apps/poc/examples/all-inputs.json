{
  "clientForm": {
    "title": "About you",
    "description": "Fill in every kind of input.",
    "questions": [
      {
        "id": "full_name",
        "type": "string",
        "label": "Full name",
        "description": "Short answer text.",
        "required": true,
        "config": {
          "placeholder": "e.g. Hoshina Suzuki",
          "maxLength": 80
        }
      },
      {
        "id": "bio",
        "type": "textarea",
        "label": "Short bio",
        "description": "Paragraph text. Tell us about yourself.",
        "config": {
          "placeholder": "I'm a ...",
          "minRows": 3,
          "maxRows": 8,
          "maxLength": 500
        }
      },
      {
        "id": "secret_code",
        "type": "password",
        "label": "Invite code",
        "description": "Hidden input. We won't show it back.",
        "config": {
          "placeholder": "•••••••",
          "minLength": 4
        }
      },
      {
        "id": "age",
        "type": "number",
        "label": "Age",
        "config": {
          "min": 0,
          "max": 120,
          "step": 1,
          "default": 25
        }
      },
      {
        "id": "country",
        "type": "select-string",
        "label": "Country",
        "description": "Single-value dropdown with text values.",
        "required": true,
        "config": {
          "placeholder": "Pick one",
          "options": [
            { "label": "Japan", "value": "JP" },
            { "label": "Thailand", "value": "TH" },
            { "label": "United States", "value": "US" },
            { "label": "Germany", "value": "DE" }
          ],
          "default": "JP"
        }
      },
      {
        "id": "tshirt_size",
        "type": "select-number",
        "label": "T-shirt size (chest cm)",
        "description": "Single-value dropdown with number values.",
        "config": {
          "options": [
            { "label": "S (90cm)", "value": 90 },
            { "label": "M (100cm)", "value": 100 },
            { "label": "L (110cm)", "value": 110 },
            { "label": "XL (120cm)", "value": 120 }
          ],
          "default": 100
        }
      },
      {
        "id": "languages",
        "type": "multi-select",
        "label": "Languages you speak",
        "description": "Multi-select dropdown.",
        "config": {
          "placeholder": "Pick any",
          "maxValues": 5,
          "options": [
            { "label": "English", "value": "en" },
            { "label": "Japanese", "value": "ja" },
            { "label": "Thai", "value": "th" },
            { "label": "German", "value": "de" },
            { "label": "French", "value": "fr" },
            { "label": "Spanish", "value": "es" }
          ],
          "default": ["en"]
        }
      },
      {
        "id": "contact_pref",
        "type": "radio",
        "label": "Preferred contact",
        "description": "Single choice via radio buttons.",
        "required": true,
        "config": {
          "options": [
            { "label": "Email", "value": "email" },
            { "label": "Phone", "value": "phone" },
            { "label": "Carrier pigeon", "value": "pigeon" }
          ],
          "default": "email"
        }
      },
      {
        "id": "interests",
        "type": "checkbox-group",
        "label": "Interests",
        "description": "Multi-select via checkboxes.",
        "config": {
          "options": [
            { "label": "Coffee", "value": "coffee" },
            { "label": "Cooking", "value": "cooking" },
            { "label": "Cycling", "value": "cycling" },
            { "label": "Reading", "value": "reading" },
            { "label": "Gaming", "value": "gaming" }
          ],
          "default": ["coffee", "reading"]
        }
      },
      {
        "id": "newsletter",
        "type": "boolean",
        "label": "Subscribe to newsletter",
        "description": "Yes/No switch.",
        "config": {
          "default": true
        }
      },
      {
        "id": "plan",
        "type": "segmented",
        "label": "Plan",
        "description": "Segmented control.",
        "config": {
          "options": [
            { "label": "Free", "value": "free" },
            { "label": "Pro", "value": "pro" },
            { "label": "Team", "value": "team" }
          ],
          "default": "pro"
        }
      },
      {
        "id": "satisfaction",
        "type": "slider",
        "label": "Overall satisfaction",
        "description": "Linear scale (slider).",
        "config": {
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 7,
          "marks": [
            { "value": 0, "label": "0" },
            { "value": 5, "label": "5" },
            { "value": 10, "label": "10" }
          ]
        }
      },
      {
        "id": "quality",
        "type": "rating",
        "label": "Rate the product",
        "description": "Star rating, half-stars allowed.",
        "config": {
          "count": 5,
          "fractions": 2,
          "default": 4
        }
      },
      {
        "id": "fav_color",
        "type": "color",
        "label": "Favourite color",
        "description": "Color picker (hex).",
        "config": {
          "default": "#7048e8",
          "swatches": ["#fa5252", "#fd7e14", "#fab005", "#40c057", "#228be6", "#7048e8", "#000000", "#ffffff"]
        }
      },
      {
        "id": "birthday",
        "type": "date",
        "label": "Birthday",
        "description": "Date picker.",
        "config": {
          "min": "1900-01-01",
          "max": "2025-12-31"
        }
      },
      {
        "id": "wake_time",
        "type": "time",
        "label": "Usual wake time",
        "description": "Time picker.",
        "config": {
          "default": "07:30"
        }
      },
      {
        "id": "event_at",
        "type": "datetime",
        "label": "Event start",
        "description": "Date + time.",
        "config": {
          "default": "2026-06-01T19:00"
        }
      },
      {
        "id": "skills",
        "type": "tags",
        "label": "Skills",
        "description": "Free-form tags (press Enter to add).",
        "config": {
          "placeholder": "Type and press Enter",
          "maxTags": 8,
          "default": ["typescript", "react"]
        }
      }
    ]
  },
  "labForm": {
    "title": "Reviewer notes",
    "description": "Add measurements and a verdict. The client's answers are shown read-only above for context.",
    "questions": [
      {
        "id": "measurement",
        "type": "repeatable-group",
        "label": "Measurements",
        "description": "Three repeated measurement rows with two readings each.",
        "required": true,
        "config": {
          "count": 3,
          "itemLabel": "Measurement",
          "questions": [
            {
              "id": "reading_a",
              "type": "number",
              "label": "Reading A",
              "required": true,
              "config": {
                "min": 0,
                "step": 0.01,
                "placeholder": "Reading A"
              }
            },
            {
              "id": "reading_b",
              "type": "number",
              "label": "Reading B",
              "required": true,
              "config": {
                "min": 0,
                "step": 0.01,
                "placeholder": "Reading B"
              }
            }
          ]
        }
      },
      {
        "id": "verdict",
        "type": "radio",
        "label": "Reviewer verdict",
        "required": true,
        "config": {
          "options": [
            { "label": "Approve", "value": "approve" },
            { "label": "Reject", "value": "reject" },
            { "label": "Needs follow-up", "value": "followup" }
          ],
          "default": "approve"
        }
      },
      {
        "id": "reviewer_notes",
        "type": "textarea",
        "label": "Notes",
        "config": {
          "placeholder": "Anything to flag?",
          "minRows": 2,
          "maxRows": 6
        }
      },
      {
        "id": "reviewed_at",
        "type": "datetime",
        "label": "Reviewed at",
        "required": true,
        "config": {
          "default": "2026-06-19T10:00"
        }
      }
    ]
  },
  "calculations": {
    "interestCount": {
      "formula": "len(interests)"
    },
    "languageCount": {
      "formula": "len(languages)"
    },
    "approved": {
      "formula": "verdict == 'approve'"
    },
    "scoreOutOfTen": {
      "formula": "(quality or 0) * 2"
    },
    "avg_a": {
      "formula": "mean(reading_a)"
    },
    "avg_b": {
      "formula": "mean(reading_b)"
    }
  },
  "values": {
    "full_name": "Hoshina Suzuki",
    "bio": "I'm a developer who loves forms.",
    "secret_code": "h0sh1n4",
    "age": 25,
    "country": "JP",
    "tshirt_size": 100,
    "languages": ["en", "ja"],
    "contact_pref": "email",
    "interests": ["coffee", "reading"],
    "newsletter": true,
    "plan": "pro",
    "satisfaction": 7,
    "quality": 4,
    "fav_color": "#7048e8",
    "birthday": "1990-05-15",
    "wake_time": "07:30",
    "event_at": "2026-06-01T19:00",
    "skills": ["typescript", "react"],
    "verdict": "approve",
    "reviewer_notes": "",
    "reviewed_at": "2026-06-19T10:00",
    "reading_a": [10.1, 10.2, 9.9],
    "reading_b": [10.0, 10.3, 10.1]
  }
}
