# Experiment Manager REST API (server-side only; apps/poc acts as BFF)
# Default: http://experiment-manager.mapfox.hoshina.san
EXPERIMENT_MANAGER_URL=http://experiment-manager.mapfox.hoshina.san

# Custapi REST API (server-side only; used for login and organization lookup)
# Default: http://custapi.mapfox.hoshina.san/api/v1
CUSTAPI_URL=http://custapi.mapfox.hoshina.san/api/v1

# Ticketing Service REST API (server-side only; tracks ticket lifecycle state)
# Default: http://ticketing-service.mapfox.hoshina.san
TICKETING_SERVICE_URL=http://ticketing-service.mapfox.hoshina.san

# Required in production; used to sign and verify login session cookies.
JWT_SECRET=change-me

# Optional override for the session cookie Secure flag.
# Defaults to true in production. Set false for HTTP-only deployments.
SESSION_COOKIE_SECURE=false
