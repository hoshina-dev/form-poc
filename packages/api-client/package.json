{
  "name": "@hoshina-dev/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "check": "tsc --noEmit",
    "codegen": "rm -rf \"src/*.d.ts\" && sh ./ts-codegen.sh && pnpm format"
  },
  "devDependencies": {
    "@hoshina-dev/eslint-config": "workspace:*",
    "@hoshina-dev/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  }
}
